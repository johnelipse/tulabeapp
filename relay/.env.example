# Tulabe mobile push relay - environment
# The service-account JSON downloaded from Firebase Console -> Project settings
# -> Service accounts -> Generate new private key.
FCM_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# ...or inline credentials instead of the path above:
# FCM_SERVICE_ACCOUNT={"type":"service_account",...}

RELAY_PORT=8787

# Optional shared secret; when set, every /api/push/* call must send it as
# header `X-Relay-Key` (mobile app). The external scheduler (cron-job.org) may
# also send it as `X-API-Key` or `Authorization: Bearer`. Keep it in the
# app's .env as PUSH_RELAY_KEY too.
RELAY_KEY=

# Device tokens are persisted here (survives restarts).
TOKENS_FILE=tokens.json
LAST_CURSOR_FILE=last_cursor.txt

# Optional automatic "new on Tulabe" notifications. Set both to enable.
# TULABE_API_URL points at the existing PUBLIC API (read-only) used only to
# learn when new movies/series are added.
TULABE_API_URL=https://tulabe-api.lectify.education/api
# Web origin used to build deep-link URLs in the push payload.
TULABE_WEB_URL=https://tulabe.lectify.education
# Minutes between checks (0 disables the poller).
POLL_INTERVAL_MIN=15